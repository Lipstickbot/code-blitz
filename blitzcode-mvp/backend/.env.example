ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://blitzcode:blitzcode@localhost:5432/blitzcode
JWT_SECRET=change-me-in-production
AUTO_CREATE_TABLES=true
MAX_SUBMISSION_CODE_BYTES=64000
SUBMISSION_RATE_LIMIT_COUNT=30
SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_COUNT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MATCHMAKING_RATE_LIMIT_COUNT=40
MATCHMAKING_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMITER_BACKEND=auto
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=0.35
MIN_JUDGE_TIMEOUT_SECONDS=1
MAX_JUDGE_TIMEOUT_SECONDS=5
JUDGE_EXECUTOR=local
JUDGE_DOCKER_BINARY=docker
JUDGE_PYTHON_IMAGE=python:3.12-alpine
JUDGE_NODE_IMAGE=node:22-alpine
JUDGE_DOCKER_MEMORY=128m
JUDGE_DOCKER_CPUS=0.5
JUDGE_DOCKER_PIDS_LIMIT=128
RUN_TEST_LIMIT=5
SUBMIT_TEST_LIMIT=50
NODE_BINARY=node
